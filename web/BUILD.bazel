# web — the browser app consumer of the JS host family (SYSTEMS.md §13.4).
#
# Keep the app as a normal Vite package for local iteration, but make the production
# bundle a Bazel action so the stable //web:app target is a real graph node. The
# live browser VM consumes Bazel-staged kernel/image artifacts through Vite's
# public asset path; no checked-in copied wasm/tar assets.

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

WEB_SOURCES = [
    "index.html",
    "package.json",
    "tsconfig.app.json",
    "tsconfig.json",
    "tsconfig.node.json",
    "vite.config.ts",
] + [
    "tools/vite.mjs",
] + glob([
    "public/**",
    "src/**",
]) + [
    ":hero_vm_assets",
]

# @mc/elements ships a rolldown bundle with its deps inlined, so this app depends on
# @mc/elements ALONE — no transitive closure to re-declare. (The bundle keeps Node
# builtins external; vite stubs them for the browser as before.)
WEB_APP_DEPS = [
    "//docs:reference_sources",
    ":node_modules/@fontsource-variable/inter",
    ":node_modules/@fontsource-variable/inter-tight",
    ":node_modules/@fontsource-variable/newsreader",
    ":node_modules/@fontsource/ibm-plex-mono",
    ":node_modules/@lezer/common",
    ":node_modules/@lezer/highlight",
    ":node_modules/@lezer/javascript",
    ":node_modules/@lezer/lr",
    ":node_modules/@mc/elements",
    ":node_modules/@stylexjs/stylex",
    ":node_modules/@stylexjs/unplugin",
    ":node_modules/@vitejs/plugin-react",
    ":node_modules/react",
    ":node_modules/react-dom",
    ":node_modules/scheduler",
    ":node_modules/typescript",
    ":node_modules/vite",
]

# Kernel + every shipped flavor tar + catalog-compiler.wasm, served at /mc/. The hero
# + "Boot a VM" boot image.tar (atlas, so the live shell has both Luau and SQLite);
# the "Images" pill boots a specific flavor from /mc/<flavor>.tar. The generated
# manifest binds every stable public path to its content digest, so the web app can
# bypass stale intermediary caches without sacrificing cross-page blob reuse.
js_binary(
    name = "stage_vm_assets_bin",
    entry_point = "tools/stage-vm-assets.mjs",
)

js_run_binary(
    name = "hero_vm_assets",
    srcs = [
        "//memcontainers/images:atlas",
        "//memcontainers/images:loom",
        "//memcontainers/images:minimal",
        "//memcontainers/images:paper",
        "//memcontainers/images:posix",
        "//memcontainers/kernel/rust:kernel",
        "//memcontainers/lib/catalog-compiler:wasm",
        "//memcontainers/programs/browser:browser_ctl_layer",
    ],
    outs = [
        "public/mc/artifacts.json",
        "public/mc/atlas.tar",
        "public/mc/browser-ctl.tar",
        "public/mc/catalog-compiler.wasm",
        "public/mc/image.tar",
        "public/mc/kernel.wasm",
        "public/mc/loom.tar",
        "public/mc/minimal.tar",
        "public/mc/paper.tar",
        "public/mc/posix.tar",
    ],
    args = [
        "--manifest",
        "$(execpath public/mc/artifacts.json)",
        "--artifact",
        "kernel",
        "/mc/kernel.wasm",
        "$(execpath //memcontainers/kernel/rust:kernel)",
        "$(execpath public/mc/kernel.wasm)",
        "--artifact",
        "catalogCompiler",
        "/mc/catalog-compiler.wasm",
        "$(execpath //memcontainers/lib/catalog-compiler:wasm)",
        "$(execpath public/mc/catalog-compiler.wasm)",
        "--artifact",
        "browserControl",
        "/mc/browser-ctl.tar",
        "$(execpath //memcontainers/programs/browser:browser_ctl_layer)",
        "$(execpath public/mc/browser-ctl.tar)",
        "--image",
        "default",
        "/mc/image.tar",
        "$(execpath //memcontainers/images:atlas)",
        "$(execpath public/mc/image.tar)",
        "--image",
        "minimal",
        "/mc/minimal.tar",
        "$(execpath //memcontainers/images:minimal)",
        "$(execpath public/mc/minimal.tar)",
        "--image",
        "posix",
        "/mc/posix.tar",
        "$(execpath //memcontainers/images:posix)",
        "$(execpath public/mc/posix.tar)",
        "--image",
        "loom",
        "/mc/loom.tar",
        "$(execpath //memcontainers/images:loom)",
        "$(execpath public/mc/loom.tar)",
        "--image",
        "atlas",
        "/mc/atlas.tar",
        "$(execpath //memcontainers/images:atlas)",
        "$(execpath public/mc/atlas.tar)",
        "--image",
        "paper",
        "/mc/paper.tar",
        "$(execpath //memcontainers/images:paper)",
        "$(execpath public/mc/paper.tar)",
    ],
    tool = ":stage_vm_assets_bin",
)

filegroup(
    name = "sources",
    srcs = WEB_SOURCES,
)

js_binary(
    name = "vite_bin",
    chdir = package_name(),
    data = [
        ":node_modules/@stylexjs/unplugin",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/typescript",
        ":node_modules/vite",
    ],
    entry_point = "tools/vite.mjs",
)

js_binary(
    name = "dev",
    chdir = package_name(),
    data = WEB_APP_DEPS + [
        ":sources",
    ],
    entry_point = "tools/vite.mjs",
    fixed_args = [
        "dev",
        "--host",
        "127.0.0.1",
        "--port",
        "5173",
        # Workspace deps (@mc/elements) change under an unchanged lockfile, which vite's
        # dep-optimizer cache can't see — force re-optimization so stale pre-bundles
        # never miss a new export.
        "--force",
    ],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "tsc_bin",
    chdir = package_name(),
    data = [":node_modules/typescript"],
    entry_point = "tools/tsc-check.mjs",
)

js_run_binary(
    name = "typecheck_app",
    srcs = WEB_APP_DEPS + [
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":sources",
    ],
    outs = ["typecheck_app.stamp"],
    args = [
        "--stamp-out",
        "$(execpath typecheck_app.stamp)",
        "--",
        "-p",
        "tsconfig.app.json",
        "--noEmit",
        "--incremental",
        "false",
    ],
    chdir = package_name(),
    tool = ":tsc_bin",
)

js_run_binary(
    name = "typecheck_node",
    srcs = [
        ":node_modules/@stylexjs/unplugin",
        ":node_modules/@types/node",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/typescript",
        ":node_modules/vite",
        ":sources",
    ],
    outs = ["typecheck_node.stamp"],
    args = [
        "--stamp-out",
        "$(execpath typecheck_node.stamp)",
        "--",
        "-p",
        "tsconfig.node.json",
        "--noEmit",
        "--incremental",
        "false",
    ],
    chdir = package_name(),
    tool = ":tsc_bin",
)

filegroup(
    name = "typecheck",
    srcs = [
        ":typecheck_app",
        ":typecheck_node",
    ],
)

js_run_binary(
    name = "app",
    srcs = WEB_APP_DEPS + [
        ":sources",
    ],
    args = [
        "build",
        "--outDir",
        "dist",
    ],
    chdir = package_name(),
    out_dirs = ["dist"],
    tool = ":vite_bin",
    visibility = ["//visibility:public"],
)
