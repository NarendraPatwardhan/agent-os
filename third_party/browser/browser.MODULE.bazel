# Firecracker browser-runner image inputs (B4).
#
# rules_pkg is also the deterministic tar for memcontainers/images and the
# firecracker bundle; one home. rules_oci serves this browser runner image only.
# @umoci unpacks the OCI layout into a rootfs for mkinitramfs (host build tool).

bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_oci", version = "2.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "headless_shell",
    digest = "sha256:7f8ec4782f1b138c30900e65ae53795d5966fbf52168b8fc062843db3e6d5be5",
    image = "docker.io/chromedp/headless-shell",
    platforms = ["linux/amd64"],
)
use_repo(oci, "headless_shell", "headless_shell_linux_amd64")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Host build tool: umoci unpack for //server/sidecars/firecracker/browser:initramfs.
http_file(
    name = "umoci",
    downloaded_file_path = "umoci",
    executable = True,
    sha256 = "b51c267ec394499e42c6fde47f240b7b7dba57ea49df0b5acd304378b82a3b71",
    urls = ["https://github.com/opencontainers/umoci/releases/download/v0.6.0/umoci.linux.amd64"],
)

# Static musl BusyBox 1.35.0 packed at /usr/bin/busybox by
# //server/sidecars/firecracker/browser:runtime_layer. init.sh uses it for `ip`
# (the headless-shell base has no iproute2) plus `rm`/`sleep`. Same class as
# @bun_browser and @headless_shell — a runner-rootfs binary, not AgentOS userland.
http_file(
    name = "busybox_browser",
    downloaded_file_path = "busybox",
    executable = True,
    sha256 = "6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348",
    urls = ["https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox"],
)

# The headless-shell base has no JavaScript runtime. Bun is the browser control
# adapter; if a future complete base already supplies a suitable runtime, retain it.
http_archive(
    name = "bun_browser",
    build_file = "//third_party/browser:BUILD.bun.bazel",
    sha256 = "a063908ae08b7852ca10939bbdc6ceed3ddabce8fb9402dce83d65d73b36e6c7",
    strip_prefix = "bun-linux-x64-baseline",
    type = "zip",
    urls = ["https://github.com/oven-sh/bun/releases/download/bun-v1.3.14/bun-linux-x64-baseline.zip"],
)
