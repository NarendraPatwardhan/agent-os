# sqlite — the SQLite 3.51.0 amalgamation fetched from sqlite.org (B3: fetch
# upstream, never vendor). 3.51.0 ships native SQLITE_WASI support (the
# unix-dotfile VFS over WASI fds), so the wasm32-wasi + mc build needs no core
# patches — only the compile defines in
# memcontainers/programs/sqlite/glue/BUILD.bazel. The Zig glue @cImports
# sqlite3.h and links sqlite3.c as a csrc (see BUILD.sqlite.bazel).

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sqlite",
    build_file = "//third_party/sqlite:BUILD.sqlite.bazel",
    sha256 = "1caf7116f2910600d04473ad69d37ec538fa62fa36adccd37b5e0e43647c98be",
    strip_prefix = "sqlite-amalgamation-3510000",
    type = "zip",
    urls = ["https://sqlite.org/2025/sqlite-amalgamation-3510000.zip"],
)
