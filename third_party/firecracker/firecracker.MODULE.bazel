# Firecracker runner inputs. Deployment artifacts, not source dependencies;
# Bazel-addressed and digest-pinned so the reference runner and its KVM proof
# cannot pick up host-installed versions (B4). The architecture-specific bundle
# is separate from the ordinary AgentOS package.

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive(
    name = "firecracker",
    build_file = "//third_party/firecracker:BUILD.firecracker.bazel",
    sha256 = "d4a32ab2322d887ca1bc4a4e7afa9cc35393e6362dfc2b3becb389d362e4275a",
    strip_prefix = "release-v1.15.1-x86_64",
    urls = ["https://github.com/firecracker-microvm/firecracker/releases/download/v1.15.1/firecracker-v1.15.1-x86_64.tgz"],
)

http_file(
    name = "firecracker_kernel",
    downloaded_file_path = "vmlinux-6.1.155",
    executable = False,
    sha256 = "e20e46d0c36c55c0d1014eb20576171b3f3d922260d9f792017aeff53af3d4f2",
    urls = ["https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.15/x86_64/vmlinux-6.1.155"],
)
