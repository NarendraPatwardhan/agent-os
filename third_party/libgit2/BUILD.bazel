# libgit2 packaging for the host git engine (GIT.md PR0 / K26).
# The compiled library comes from BCR @libgit2; this package holds license
# materials, patches, and a corresponding-source filegroup for releases.

package(default_visibility = ["//visibility:public"])

exports_files([
    "emscripten_integer.patch",
    "NOTICE",
    "SOURCE_PIN.md",
])

filegroup(
    name = "notices",
    srcs = [
        "NOTICE",
        "upstream/AUTHORS",
        "upstream/COPYING",
    ],
)

filegroup(
    name = "patches",
    srcs = ["emscripten_integer.patch"],
)

# L3 — corresponding source materials: pin metadata + patches + license texts.
# Release packaging attaches this filegroup next to engine artifacts (PR0b/PR2).
# The full BCR-resolved source tree is obtained via the MODULE pin + patches;
# SOURCE_PIN.md records URL + sha256 for independent verification.
filegroup(
    name = "corresponding_source",
    srcs = [
        "NOTICE",
        "SOURCE_PIN.md",
        "emscripten_integer.patch",
        "upstream/AUTHORS",
        "upstream/COPYING",
    ],
)

# Convenience: product packages can depend on this for L1+L2 notice embedding.
alias(
    name = "license_files",
    actual = ":notices",
)
