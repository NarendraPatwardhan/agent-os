# Private include paths are propagated only to the pin adapter. The target runtime cannot depend on
# this CcInfo target and therefore cannot accidentally include private CodeGen representation.
cc_headers(
    name = "aot_frontend_codegen_ir_incs",
    hdrs = [],
    includes = [
        "CodeGen/include",
        "CodeGen/src",
    ],
    visibility = ["//visibility:public"],
)

# The interpreter's translation units: VM (bytecode exec) + Compiler + Ast + Bytecode + Common.
filegroup(
    name = "interp_srcs",
    srcs = glob([
        "VM/src/*.cpp",
        "Compiler/src/*.cpp",
        "Ast/src/*.cpp",
        "Bytecode/src/*.cpp",
        "Common/src/*.cpp",
    ]),
    visibility = ["//visibility:public"],
)

# luau-analyze's translation units: the full interp set (VM + Compiler + Ast + Bytecode + Common) +
# Config + the Analysis type-inference engine — matching memcontainers' xtask (the Analysis engine
# references VM/Compiler symbols even though it never executes). Autocomplete/Fragment excluded —
# editor-only, not needed for --check.
filegroup(
    name = "analyze_srcs",
    srcs = glob(
        [
            "VM/src/*.cpp",
            "Compiler/src/*.cpp",
            "Ast/src/*.cpp",
            "Bytecode/src/*.cpp",
            "Common/src/*.cpp",
            "Config/src/*.cpp",
            "Analysis/src/*.cpp",
        ],
        exclude = [
            "Analysis/src/Autocomplete.cpp",
            "Analysis/src/AutocompleteCore.cpp",
            "Analysis/src/FragmentAutocomplete.cpp",
        ],
    ),
    visibility = ["//visibility:public"],
)

# All Config + Analysis headers, as plain files for the analyze csrcs compile (extra_srcs); the
# Ast/Common headers come from :interp_all_hdrs.
filegroup(
    name = "analysis_all_hdrs",
    srcs = glob([
        "Config/**/*.h",
        "Analysis/**/*.h",
    ]),
    visibility = ["//visibility:public"],
)

# -I-only header sets (NO direct_public_headers) for the analyze build, which has NO @cImport. A
# zig_binary with cc cdeps still runs translate-c over their public headers, and translate-c (C-only)
# cannot parse Luau's C++ Analysis headers. With hdrs=[] it #includes nothing; the header FILES reach
# the csrcs compile via :interp_all_hdrs / :analysis_all_hdrs.
cc_headers(
    name = "interp_incs",
    hdrs = [],
    includes = [
        "Ast/include",
        "Ast/src",
        "Bytecode/include",
        "Bytecode/src",
        "Common/include",
        "Common/src",
        "Compiler/include",
        "Compiler/src",
        "VM/include",
        "VM/src",
    ],
    visibility = ["//visibility:public"],
)

cc_headers(
    name = "analysis_incs",
    hdrs = [],
    includes = [
        "Analysis/include",
        "Analysis/src",
        "Config/include",
    ],
    visibility = ["//visibility:public"],
)

# The PUBLIC Lua C API headers ONLY (VM/include: lua.h, lualib.h, luaconf.h — all pure C), exposed
# as a CcInfo (no CC toolchain — see //bazel:mc_program.bzl). rules_zig's @cImport translates
# every `direct_public_header` of its cdeps, so this MUST exclude the C++-tainted internal headers
# (e.g. Common/include/Luau/TimeTrace.h → <vector>) that translate-c (C-only) can't parse. `includes`
# still lists every dir so the csrcs (compiled by zig c++, which handles C++ fine) resolve their
# internal #includes; the internal header FILES reach the compile via :interp_all_hdrs (extra_srcs).
cc_headers(
    name = "interp_headers",
    hdrs = glob(["VM/include/*.h"]),
    includes = [
        "Ast/include",
        "Ast/src",
        "Bytecode/include",
        "Bytecode/src",
        "Common/include",
        "Common/src",
        "Compiler/include",
        "Compiler/src",
        "VM/include",
        "VM/src",
    ],
    visibility = ["//visibility:public"],
)

# ALL interpreter headers (public + internal), as plain files for the csrcs compile (extra_srcs).
# These are NOT a cdep — they must not become @cImport `direct_public_headers`.
filegroup(
    name = "interp_all_hdrs",
    srcs = glob([
        "VM/**/*.h",
        "Compiler/**/*.h",
        "Ast/**/*.h",
        "Bytecode/**/*.h",
        "Common/**/*.h",
    ]),
    visibility = ["//visibility:public"],
)

# Config + Analysis headers for luau-analyze (the build also deps :interp_headers + force-includes
# analysis_eh_shim.h via copts).
cc_headers(
    name = "analysis_headers",
    hdrs = glob([
        "Config/include/**/*.h",
        "Analysis/include/**/*.h",
        "Analysis/src/*.h",
    ]),
    includes = [
        "Analysis/include",
        "Analysis/src",
        "Config/include",
    ],
    visibility = ["//visibility:public"],
)
