# build_file for the patched @luau source (http_archive build_file = "//third_party/luau:BUILD.luau.bazel"),
# evaluated in the @luau repo context. It only EXPOSES the upstream source; the actual zig c++ build
# (//memcontainers/programs/luau/glue:luau / :luau-analyze) lives in the main repo and references these. See
# third_party/luau/SYSTEM.md.

load("@agent-os//bazel:mc_program.bzl", "cc_headers")

# Pin-specific source policy for the Luau AOT frontend and target runtime. These lists are explicit
# so an upstream pin update cannot silently add a compiler, loader, or bytecode executor to the
# runtime boundary. They are declarations only: the retained set does not link until the
# lvmexecute-owned call/frame helpers recorded in luau_aot_runtime_sources.json are replaced.
