# luau as a guest — vendor LESS, patch in place (SYSTEMS.md, B3). Upstream source enters via
# http_archive(urls, sha256, patches=[...]) in MODULE.bazel; ONLY our deltas live in-tree:
#   patches/           — the `// mc PATCH` set as real .patch files (VM/Parser/Compiler,
#                        Analysis, frontend nothread, and strict-AOT frame dispatch), applied to
#                        upstream 0.725 (B3).
#   glue/              — trap / sys / stdlib / the batteries / entry, written in ZIG; three C++
#                        holdouts (error_channel.h, analysis_eh_shim.h, analyze_main.cpp).
#   BUILD.luau.bazel   — the build_file http_archive applies to the extracted source (Phase 4).
# See third_party/luau/SYSTEM.md.
#
# luau needs the kernel-mediated non-local exit because wasmi has no exception proposal — Lua
# `error`/`pcall` and C++ EH unwind through the kernel's trap boundary (SYSTEMS.md).

load("@aspect_rules_js//js:defs.bzl", "js_library")

# The patch files + the build_file are referenced as labels by the http_archive (resolved in the
# @luau repo context), so they must be exported from this package.
exports_files([
    "BUILD.luau.bazel",
    "patches/0001-mc-vm.patch",
    "patches/0002-mc-analysis.patch",
    "patches/0003-mc-analysis-named-catch.patch",
    "patches/0004-mc-frontend-nothread.patch",
    "patches/0005-mc-aot-runtime-dispatch.patch",
])

js_library(
    name = "frontend_contract_inputs",
    srcs = [
        "BUILD.bazel",
        "BUILD.luau.bazel",
        "patches/0001-mc-vm.patch",
        "patches/0002-mc-analysis.patch",
        "patches/0003-mc-analysis-named-catch.patch",
        "patches/0004-mc-frontend-nothread.patch",
        "patches/0005-mc-aot-runtime-dispatch.patch",
    ],
    visibility = ["//visibility:public"],
)
