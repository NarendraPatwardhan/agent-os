load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@rules_elixir//:defs.bzl", "mix_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:elixir_transition.bzl", "ELIXIR_ONLY", "elixir_test")
load("//bazel:ts.bzl", "mc_ts_project")
load("//memcontainers/hosts/wasmtime:defs.bzl", "host_release_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "SPEC.md",
    "results/schema.json",
])

mc_ts_project(
    name = "result_lib",
    srcs = ["lib/result.ts"],
)

mc_ts_project(
    name = "system_lib",
    srcs = ["lib/system.ts"],
    deps = ["//:node_modules/@types/bun"],
)

mc_ts_project(
    name = "sdk_lib",
    srcs = ["lib/sdk.ts"],
    deps = ["//memcontainers/sdk-js/core:lib"],
)

mc_ts_project(
    name = "results_lib",
    srcs = [
        "results/aggregate.ts",
        "results/validate.ts",
    ],
    deps = [
        ":result_lib",
        "//:node_modules/@types/bun",
    ],
)

js_binary(
    name = "validate",
    data = [":results_lib"],
    entry_point = "results/validate.js",
)

js_binary(
    name = "aggregate",
    data = [":results_lib"],
    entry_point = "results/aggregate.js",
)

mc_ts_project(
    name = "result_test_lib",
    srcs = ["test/result.test.ts"],
    deps = [
        ":result_lib",
        "//:node_modules/@types/bun",
    ],
)

mc_ts_project(
    name = "validate_test_lib",
    srcs = ["test/validate.test.ts"],
    deps = [
        ":result_lib",
        ":results_lib",
        "//:node_modules/@types/bun",
    ],
)

js_test(
    name = "result_test",
    data = [
        "package.json",
        ":result_test_lib",
    ],
    entry_point = "test/result.test.js",
)

js_test(
    name = "validate_test",
    data = [
        "package.json",
        ":validate_test_lib",
    ],
    entry_point = "test/validate.test.js",
)

test_suite(
    name = "test",
    tests = [
        ":result_test",
        ":validate_test",
    ],
)

mc_ts_project(
    name = "embedded_runner_lib",
    srcs = ["runners/embedded/runner.ts"],
    deps = [
        ":result_lib",
        ":sdk_lib",
        ":system_lib",
        "//:node_modules/@types/bun",
    ],
)

js_binary(
    name = "embedded",
    data = [
        ":embedded_runner_lib",
        "//memcontainers/images:atlas",
        "//memcontainers/images:loom",
        "//memcontainers/images:minimal",
        "//memcontainers/images:paper",
        "//memcontainers/images:posix",
        "//memcontainers/kernel/rust:kernel",
    ],
    entry_point = "runners/embedded/runner.js",
    env = {
        "MC_ATLAS_IMAGE": "$(rlocationpath //memcontainers/images:atlas)",
        "MC_KERNEL_WASM": "$(rlocationpath //memcontainers/kernel/rust:kernel)",
        "MC_LOOM_IMAGE": "$(rlocationpath //memcontainers/images:loom)",
        "MC_MINIMAL_IMAGE": "$(rlocationpath //memcontainers/images:minimal)",
        "MC_PAPER_IMAGE": "$(rlocationpath //memcontainers/images:paper)",
        "MC_POSIX_IMAGE": "$(rlocationpath //memcontainers/images:posix)",
    },
)

mc_ts_project(
    name = "browser_page_lib",
    srcs = ["runners/browser/page.ts"],
    deps = [
        ":result_lib",
        ":sdk_lib",
    ],
)

mc_ts_project(
    name = "browser_runner_lib",
    srcs = ["runners/browser/runner.ts"],
    deps = [
        ":result_lib",
        ":results_lib",
        "//:node_modules/@types/bun",
    ],
)

js_binary(
    name = "browser",
    data = [
        ":browser_page_lib",
        ":browser_runner_lib",
        "//memcontainers/images:atlas",
        "//memcontainers/images:loom",
        "//memcontainers/images:minimal",
        "//memcontainers/images:paper",
        "//memcontainers/images:posix",
        "//memcontainers/kernel/rust:kernel",
        "//memcontainers/sdk-js/core:lib",
    ],
    entry_point = "runners/browser/runner.js",
    env = {
        "MC_ATLAS_IMAGE": "$(rlocationpath //memcontainers/images:atlas)",
        "MC_KERNEL_WASM": "$(rlocationpath //memcontainers/kernel/rust:kernel)",
        "MC_LOOM_IMAGE": "$(rlocationpath //memcontainers/images:loom)",
        "MC_MINIMAL_IMAGE": "$(rlocationpath //memcontainers/images:minimal)",
        "MC_PAPER_IMAGE": "$(rlocationpath //memcontainers/images:paper)",
        "MC_POSIX_IMAGE": "$(rlocationpath //memcontainers/images:posix)",
    },
)

rust_binary(
    name = "native_bin",
    srcs = glob(["runners/native/*.rs"]),
    crate_root = "runners/native/main.rs",
    data = [
        "//memcontainers/images:atlas",
        "//memcontainers/images:loom",
        "//memcontainers/images:minimal",
        "//memcontainers/images:paper",
        "//memcontainers/images:posix",
        "//memcontainers/kernel/rust:kernel",
    ],
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//memcontainers/hosts/wasmtime:lib",
        "@host_crates//:anyhow",
        "@host_crates//:serde",
        "@host_crates//:serde_json",
        "@host_crates//:sha2",
    ],
)

host_release_binary(
    name = "native",
    bin = ":native_bin",
)

mix_test(
    name = "server_impl",
    srcs = [
        "runners/server/result.exs",
        "runners/server/runner_test.exs",
        "runners/server/test_helper.exs",
    ],
    data = [
        ":mix.exs",
        "//memcontainers/images:atlas",
        "//memcontainers/images:posix",
        "//memcontainers/kernel/rust:kernel",
    ],
    env = {
        "ELIXIR_ERL_OPTIONS": "+fnu",
        "ERL_COMPILER_OPTIONS": "deterministic",
    },
    lib = "//server:lib_test",
    # rules_elixir's mix_test assumes its test and library share a Bazel package. Keep the
    # benchmark sources here while making the server-owned compiled app visible at the basenames
    # its generated runner expects.
    setup = """
ln -s "$(realpath ../server/lib_test_compile_ebin)" lib_test_compile_ebin
ln -s "$(realpath ../server/priv)" priv
""",
    tags = ["manual"],
    target_compatible_with = ELIXIR_ONLY,
)

elixir_test(
    name = "server",
    actual = ":server_impl",
    tags = ["manual"],
)
