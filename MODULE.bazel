"""agent-os — one build graph, zero staleness (SYSTEMS.md / B1).

This module pins hermetic toolchains (Zig, Rust, JS, OTP/Elixir), isolated crate
universes, patched upstream source (B3), digest-pinned runner artifacts (B4), and
the luauc compiler module. Runtime identity is `mc`; do not prefix ABI names
`agent-os-*`.
"""

module(
    name = "agent-os",
    bazel_compatibility = [">=8.3.1"],
    compatibility_level = 0,
    version = "0.0.0",
)

include("//bazel:zig.MODULE.bazel")
include("//bazel:rust.MODULE.bazel")
include("//bazel:js.MODULE.bazel")
include("//bazel:lint.MODULE.bazel")
include("//third_party/luauc:luauc.MODULE.bazel")
include("//third_party/sqlite:sqlite.MODULE.bazel")
include("//third_party/tree-sitter:tree-sitter.MODULE.bazel")
include("//third_party/binaryen:binaryen.MODULE.bazel")
include("//third_party/browser:browser.MODULE.bazel")
include("//third_party/firecracker:firecracker.MODULE.bazel")
include("//bazel:erlang.MODULE.bazel")

# Full registration set (Zig + in-repo wasm targets + OTP/Elixir). rules_rust 0.70
# registers @rust_toolchains from the rust extension; do not add it here.
register_toolchains(
    "@rules_zig//zig/target:all",
    "@zig_toolchains//:all",
    "//platforms:wasm32_freestanding_zig_toolchain",
    "//platforms:wasm32_wasi_zig_toolchain",
    "@erlang_config//26_2:toolchain_major",
    "@erlang_config//26_2:toolchain_major_minor",
    "@elixir_config//1_16:toolchain",
)
