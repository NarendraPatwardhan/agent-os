load(":defs.bzl", "gh_release")

# tools/gh-release — `bazel run` an AgentOS GitHub release straight from the graph, over the REST
# API (no `gh` CLI). The mechanism is in defs.bzl; this is the one concrete release target.
#
# Client-side release assets: kernel.wasm, the five SHIPPED flavor tars (minimal, posix, loom, atlas,
# paper), the self-contained @mc/core ESM bundle (mc-core.mjs), catalog-compiler.wasm, browser-ctl,
# and git-engine.tar (the zero-import freestanding Gitz Wasm module). The tool also generates and
# uploads a SHA256SUMS over those bytes. Deliberately excluded: base/rootfs (substrate, not a
# flavor), svc_test, the `mc` host binary, the Elixir/server package (incl. native Port), and a
# manifest.json index. Adding an asset is one line in `assets`.
#
# Release notes are MANDATORY (--notes / --notes-file); GitHub auto-generated notes are never used.
#
# A real release is cut on master after develop has been promoted. This target
# is defined here so it merges upward; run it from the master worktree on the release commit:
#
#   GITHUB_TOKEN=<token> bazel run //bazel/tools/gh-release:publish -- --tag v0.3.0 --notes-file NOTES.md --draft
#   bazel run //bazel/tools/gh-release:publish -- --tag v0.3.0 --notes "..." --dry-run   # validate, no network
gh_release(
    name = "publish",
    assets = {
        "//memcontainers/kernel/rust:kernel": "kernel.wasm",
        "//memcontainers/images:minimal": "minimal.tar",
        "//memcontainers/images:posix": "posix.tar",
        "//memcontainers/images:loom": "loom.tar",
        "//memcontainers/images:atlas": "atlas.tar",
        "//memcontainers/images:paper": "paper.tar",
        "//memcontainers/sdk-js/core:bundle": "mc-core.mjs",
        "//memcontainers/programs/browser:browser_ctl_layer": "browser-ctl.tar",
        "//memcontainers/lib/catalog-compiler:wasm": "catalog-compiler.wasm",
        "//memcontainers/lib/git-engine:git_engine_browser_archive": "git-engine.tar",
    },
    repo = "NarendraPatwardhan/agent-os",
    visibility = ["//visibility:public"],
)
