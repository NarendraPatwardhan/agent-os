load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("//bazel:force_opt.bzl", "force_opt")
load("//bazel:pick_file.bzl", "pick_file")
load("//bazel:wasm_opt.bzl", "wasm_opt")
load("//bazel/tools/size:defs.bzl", "size_limit")
load(":ship_gate.bzl", "assert_ship_files")

# Host-side git engine: libgit2 + ge_* Run ABI (see docs/git.md; design: GIT.md).
package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Run ABI library + fixtures
# ---------------------------------------------------------------------------

cc_library(
    name = "git_engine_lib",
    srcs = [
        "src/engine.c",
        "src/engine_ops_extra.c",
        "src/ge_engine_priv.h",
        "src/json_min.c",
        "src/json_min.h",
    ],
    hdrs = ["include/git_engine.h"],
    includes = [
        "include",
        "src",
    ],
    deps = ["@libgit2//:libgit2"],
    copts = [
        "-Wno-unused-parameter",
    ],
    linkstatic = True,
)

# Port RPC + mount only. Remotes are host-mediated (TS/BEAM orch); no C orch.
# Not linked into emcc wasm.
cc_library(
    name = "git_engine_port_lib",
    srcs = [
        "src/port_frame.c",
        "src/port_handle.c",
        "src/port_mount.c",
    ],
    hdrs = [
        "include/ge_port.h",
        "include/git_engine.h",
    ],
    includes = [
        "include",
        "src",
    ],
    deps = [":git_engine_lib"],
    copts = ["-Wno-unused-parameter"],
    linkstatic = True,
)

alias(
    name = "git_engine",
    actual = ":git_engine_lib",
)

# BEAM-owned Port binary (length-prefixed frames on stdin/stdout).
cc_binary(
    name = "git-engine",
    srcs = ["src/port_main.c"],
    deps = [":git_engine_port_lib"],
    linkstatic = True,
    visibility = ["//visibility:public"],
)

# c-shared packaging only. Product load is the Port binary; do not treat
# :libgit_engine as an in-process server runner.
cc_shared_library(
    name = "libgit_engine",
    shared_lib_name = "libgit_engine.so",
    deps = [":git_engine_lib"],
)

# L4 product ship set for the BEAM Port binary + optional c-shared packaging.
# NOTICE + upstream COPYING/AUTHORS must ship adjacent to every engine artifact.
filegroup(
    name = "git_engine_server_artifacts",
    srcs = [
        ":git-engine",
        ":libgit_engine",
        "//third_party/libgit2:notices",
        "//third_party/libgit2:corresponding_source",
    ],
    visibility = ["//visibility:public"],
)

# L5 fail-closed: native Port ship set must keep NOTICE + upstream COPYING/AUTHORS.
assert_ship_files(
    name = "git_engine_server_l5_notices_check",
    ship = ":git_engine_server_artifacts",
    required = [
        "NOTICE",
        "COPYING",
        "AUTHORS",
        "git-engine",
    ],
)

build_test(
    name = "git_engine_server_l5_notices",
    targets = [":git_engine_server_l5_notices_check"],
)

# Native ABI fixture: init→commit→log + dial refuse.
cc_test(
    name = "abi_fixture_test",
    srcs = ["abi_fixture_test.c"],
    deps = [":git_engine_lib"],
    data = glob(["testdata/abi/**"]),
    size = "small",
    linkstatic = True,
)

# Port frames: Run + binary MOUNT_OP ctl + kill-closed semantics.
cc_test(
    name = "port_frame_test",
    srcs = ["port_frame_test.c"],
    deps = [":git_engine_port_lib"],
    size = "small",
    linkstatic = True,
)

# Dual-runner native golden (emcc side: //sdk-js/core:git_engine_test).
cc_test(
    name = "abi_dual_test",
    srcs = ["abi_dual_test.c"],
    deps = [":git_engine_lib"],
    data = glob(["testdata/abi/**", "testdata/orch/**"]),
    size = "small",
    linkstatic = True,
)

exports_files([
    "exported_functions.json",
    "testdata/abi/local_init_commit.json",
    "testdata/abi/dial_forbidden.json",
    "testdata/orch/clone_success_steps.json",
    "testdata/orch/clone_empty_pack_fail.json",
    "testdata/orch/origin_denied.json",
    "testdata/orch/fetch_success_steps.json",
    "testdata/orch/pull_ff_steps.json",
    "testdata/orch/push_readonly.json",
    "testdata/orch/push_success_steps.json",
    "testdata/orch/shallow_clone_steps.json",
    "testdata/orch/auth_deny_steps.json",
    "testdata/orch/pull_not_ff_steps.json",
    "testdata/orch/origin_deny_prefix.json",
    "testdata/orch/guest_secret_reject.json",
    "testdata/orch/query_auth_reject.json",
    "testdata/orch/response_schema.json",
    "testdata/pack/minimal.pack",
    "testdata/pack/minimal.tip",
    "testdata/pack/minimal.ref",
])

filegroup(
    name = "license_files",
    srcs = ["//third_party/libgit2:license_files"],
)

# Dual-host orch vectors (TS + BEAM load the same JSON).
filegroup(
    name = "orch_algorithm_traces",
    srcs = glob(["testdata/orch/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "orch_pack_fixtures",
    srcs = glob(["testdata/pack/**"]),
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# Emscripten host wasm (createGitEngineModule) + monorepo wasm_opt + size gate
# ---------------------------------------------------------------------------

_WASM_SIZE_COPTS = [
    "-Os",
    "-DNDEBUG",
]

_WASM_LINKOPTS = [
    "-Os",
    "--no-entry",
    "-sMODULARIZE=1",
    "-sEXPORT_ES6=1",
    "-sEXPORT_NAME=createGitEngineModule",
    "-sENVIRONMENT=web,worker,node",
    "-sALLOW_MEMORY_GROWTH=1",
    "-sSTACK_SIZE=2MB",
    "-sASSERTIONS=0",
    "-sSTACK_OVERFLOW_CHECK=0",
    "-sFILESYSTEM=1",
    "-sEXPORTED_FUNCTIONS=@$(location :exported_functions.json)",
    "-sEXPORTED_RUNTIME_METHODS=['ccall','cwrap','UTF8ToString','stringToUTF8','lengthBytesUTF8','getValue','setValue','HEAPU8','FS','PATH']",
]

cc_binary(
    name = "git_engine_wasm_bin",
    srcs = ["wasm_stub.c"],
    deps = [":git_engine_lib"],
    copts = _WASM_SIZE_COPTS,
    linkopts = _WASM_LINKOPTS,
    additional_linker_inputs = [":exported_functions.json"],
    tags = ["manual"],
)

wasm_cc_binary(
    name = "git_engine_wasm_emcc",
    cc_target = ":git_engine_wasm_bin",
    outputs = [
        "git_engine_emcc.js",
        "git_engine_emcc.wasm",
    ],
    tags = ["manual"],
)

force_opt(
    name = "git_engine_wasm_emcc_release",
    target = ":git_engine_wasm_emcc",
    tags = ["manual"],
)

pick_file(
    name = "git_engine_emcc_js",
    src = ":git_engine_wasm_emcc_release",
    extension = ".js",
    out = "git_engine.js",
    tags = ["manual"],
)

pick_file(
    name = "git_engine_emcc_wasm",
    src = ":git_engine_wasm_emcc_release",
    extension = ".wasm",
    out = "git_engine_emcc_raw.wasm",
    tags = ["manual"],
)

# Monorepo Binaryen policy (-Oz --converge).
wasm_opt(
    name = "git_engine_opt",
    wasm = ":git_engine_emcc_wasm",
)

# Optimized product name + emcc's default basename (locateFile("git_engine_wasm_bin.wasm")).
genrule(
    name = "git_engine_wasm_file",
    srcs = [":git_engine_opt"],
    outs = [
        "git_engine.wasm",
        "git_engine_wasm_bin.wasm",
    ],
    cmd = "cp $< $(location git_engine.wasm) && cp $< $(location git_engine_wasm_bin.wasm)",
)

# .mjs alias so Node/browsers load EXPORT_ES6 without needing a sibling package.json
# (rules_js cannot copy cross-package source package.json into js_test runfiles).
genrule(
    name = "git_engine_mjs",
    srcs = [":git_engine_emcc_js"],
    outs = ["git_engine.mjs"],
    cmd = "cp $< $@",
)

filegroup(
    name = "git_engine_wasm",
    srcs = [
        ":git_engine_emcc_js",
        ":git_engine_mjs",
        ":git_engine_wasm_file",
        "//third_party/libgit2:notices",
    ],
)

# Soft gate ≤2 MiB on the optimized product wasm (genrule out of :git_engine_wasm_file).
# Label form — same pattern as //memcontainers/programs/git:git_size_limit (file = ":git").
# `bazel test //memcontainers/lib/git-engine:git_engine_wasm_size_limit` builds the wasm chain.
size_limit(
    name = "git_engine_wasm_size_limit",
    file = ":git_engine.wasm",
    max_bytes = 2 * 1024 * 1024,
)

# L5 fail-closed: ship filegroup must keep NOTICE + upstream COPYING/AUTHORS.
# Analysis-only (cheap) — does not force emcc; drops from :git_engine_wasm fail analysis.
assert_ship_files(
    name = "git_engine_wasm_l5_notices_check",
    ship = ":git_engine_wasm",
    required = [
        "NOTICE",
        "COPYING",
        "AUTHORS",
    ],
)

build_test(
    name = "git_engine_wasm_l5_notices",
    targets = [":git_engine_wasm_l5_notices_check"],
)
