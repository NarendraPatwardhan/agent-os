load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure_binary", "zig_library", "zig_test")
load("//bazel/tools/size:defs.bzl", "size_limit")

package(default_visibility = ["//visibility:public"])

exports_files([
    "fixtures/pack/minimal.pack",
    "fixtures/pack/minimal.tip",
    "fixtures/pack/minimal.ref",
])

zig_library(
    name = "core",
    srcs = [
        "src/errors.zig",
        "src/mount.zig",
        "src/paths.zig",
        "src/protocol.zig",
        "src/remote.zig",
        "src/repository_ops.zig",
    ],
    main = "src/core.zig",
    deps = [
        "//memcontainers/contracts:git_zig",
        "@gitz//src/config",
        "@gitz//src/fs",
        "@gitz//src/plumbing",
        "@gitz//src/plumbing/format/gitignore",
        "@gitz//src/plumbing/object",
        "@gitz//src/plumbing/protocol/packp",
        "@gitz//src/storage/memory",
        "@gitz//src/worktree",
    ],
)

zig_library(
    name = "browser_backend",
    main = "src/backends/browser.zig",
    deps = [
        "//memcontainers/contracts:git_zig",
        "@gitz//src/fs",
        "@gitz//src/persistence",
        "@gitz//src/plumbing",
        "@gitz//src/plumbing/object",
        "@gitz//src/remote",
        "@gitz//src/repo",
        "@gitz//src/storage/memory",
    ],
)

zig_library(
    name = "native_backend",
    main = "src/backends/native.zig",
    deps = [
        "//memcontainers/contracts:git_zig",
        "@gitz//src/fs",
        "@gitz//src/plumbing",
        "@gitz//src/remote",
        "@gitz//src/remote:pack_import_filesystem",
        "@gitz//src/repo",
        "@gitz//src/storage/filesystem",
        "@gitz//src/storage/memory",
    ],
)

zig_test(
    name = "core_test",
    main = "test/core_test.zig",
    deps = [
        ":browser_backend",
        ":core",
        "//memcontainers/contracts:git_zig",
        "@gitz//src/plumbing/object",
    ],
)

zig_test(
    name = "native_backend_test",
    main = "test/native_backend_test.zig",
    deps = [":native_backend"],
)

zig_binary(
    name = "git_engine_wasm_raw",
    linkopts = [
        "-fno-entry",
        "-rdynamic",
    ],
    main = "src/wasm_main.zig",
    tags = ["manual"],
    deps = [
        ":browser_backend",
        ":core",
        "//memcontainers/contracts:git_zig",
    ],
)

zig_configure_binary(
    name = "git_engine_wasm_module",
    actual = ":git_engine_wasm_raw",
    mode = "release_small",
    target = "//platforms:wasm32_freestanding",
    threaded = "single",
)

zig_configure_binary(
    name = "git_engine_wasm_debug",
    actual = ":git_engine_wasm_raw",
    mode = "debug",
    target = "//platforms:wasm32_freestanding",
    threaded = "single",
)

genrule(
    name = "git_engine_wasm_file",
    srcs = [":git_engine_wasm_module"],
    outs = ["git_engine.wasm"],
    cmd = "cp $< $@",
)

zig_binary(
    name = "git-engine",
    main = "src/port_main.zig",
    deps = [
        ":core",
        ":native_backend",
        "//memcontainers/contracts:git_zig",
        "@gitz//src/plumbing/object",
        "@gitz//src/utils/sync",
    ],
)

zig_configure_binary(
    name = "git_engine_native_release",
    actual = ":git-engine",
    mode = "release_safe",
    threaded = "single",
)

pkg_tar(
    name = "git_engine_browser_archive",
    files = {
        ":git_engine.wasm": "git_engine.wasm",
        "@gitz//:LICENSE": "share/licenses/gitz/LICENSE",
    },
    modes = {
        "share": "0755",
        "share/licenses": "0755",
        "share/licenses/gitz": "0755",
    },
    owner = "0.0",
)

build_test(
    name = "git_engine_wasm_build_test",
    targets = [":git_engine_wasm_module"],
)

build_test(
    name = "git_engine_native_build_test",
    targets = [
        ":git-engine",
        ":git_engine_native_release",
    ],
)

size_limit(
    name = "git_engine_wasm_size_limit",
    file = ":git_engine.wasm",
    max_bytes = 2 * 1024 * 1024,
)

js_test(
    name = "wasm_runtime_test",
    data = [
        "test/wasm/runtime_test.mjs",
        ":git_engine_wasm_module",
    ],
    entry_point = "test/wasm/runtime_test.mjs",
    env = {"AGENTOS_GIT_WASM": "$(rlocationpath :git_engine_wasm_module)"},
)

js_test(
    name = "wasm_debug_runtime_test",
    data = [
        "test/wasm/runtime_test.mjs",
        ":git_engine_wasm_debug",
    ],
    entry_point = "test/wasm/runtime_test.mjs",
    env = {"AGENTOS_GIT_WASM": "$(rlocationpath :git_engine_wasm_debug)"},
)

js_test(
    name = "port_runtime_test",
    data = [
        "test/port/runtime_test.mjs",
        ":git-engine",
    ],
    entry_point = "test/port/runtime_test.mjs",
    env = {"AGENTOS_GIT_ENGINE": "$(rlocationpath :git-engine)"},
)

js_test(
    name = "port_release_runtime_test",
    data = [
        "test/port/runtime_test.mjs",
        ":git_engine_native_release",
    ],
    entry_point = "test/port/runtime_test.mjs",
    env = {"AGENTOS_GIT_ENGINE": "$(rlocationpath :git_engine_native_release)"},
)

test_suite(
    name = "test",
    tests = [
        ":core_test",
        ":git_engine_native_build_test",
        ":git_engine_wasm_build_test",
        ":git_engine_wasm_size_limit",
        ":native_backend_test",
        ":port_release_runtime_test",
        ":port_runtime_test",
        ":wasm_debug_runtime_test",
        ":wasm_runtime_test",
    ],
)
