{
 "name": "fetch_success",
 "version": 1,
 "description": "Clone then fetch of the same tip succeeds.",
 "fixture": {
 "url": "https://example.com/demo.git",
 "allowed_origins": ["https://example.com"],
 "refs": [
 {
 "name": "refs/heads/main",
 "hash_from": "../pack/minimal.tip"
 }
 ],
 "pack_from": "../pack/minimal.pack"
 },
 "steps": [
 {
 "id": "clone_first",
 "op": "clone",
 "args": {
 "url": "https://example.com/demo.git"
 },
 "expect": {
 "ok": true,
 "code": 0,
 "stdout_contains": ["cloned"]
 }
 },
 {
 "id": "orchestrator_response",
 "op": "fetch",
 "args": {
 "url": "https://example.com/demo.git"
 },
 "expect": {
 "ok": true,
 "code": 0,
 "stdout_contains": ["fetched"],
 "stderr_not_contains": ["empty pack", "not allowlisted"]
 }
 }
 ]
}
