{
  "name": "pull_ff_up_to_date",
  "version": 1,
  "description": "Clone then pull of the same tip is already up to date (R34/R39/R81).",
  "fixture": {
    "url": "https://example.com/demo.git",
    "allowed_origins": ["https://example.com"],
    "refs": [
      {
        "name": "refs/heads/main",
        "hash_from": "../pack/minimal.tip"
      }
    ],
    "pack_from": "../pack/minimal.pack"
  },
  "steps": [
    {
      "id": "clone_first",
      "op": "clone",
      "args": {
        "url": "https://example.com/demo.git"
      },
      "expect": {
        "ok": true,
        "code": 0,
        "stdout_contains": ["cloned"]
      }
    },
    {
      "id": "orchestrator_response",
      "op": "pull",
      "args": {
        "url": "https://example.com/demo.git"
      },
      "expect": {
        "ok": true,
        "code": 0,
        "stdout_contains": ["Already up to date"],
        "stderr_not_contains": ["not fast-forward"]
      }
    }
  ]
}
