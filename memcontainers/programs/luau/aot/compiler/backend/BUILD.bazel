load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure_binary", "zig_library")

exports_files(
    [
        "numeric_loop.luau",
        "captured_call.luau",
        "compiled_call.luau",
        "general_call.luau",
        "multi_result_call.luau",
        "reference_capture.luau",
        "scalar_breadth.luau",
        "static_cycle_a.luau",
        "static_cycle_b.luau",
        "static_cycle_main.luau",
        "static_graph_left.luau",
        "static_graph_main.luau",
        "static_graph_middle.luau",
        "static_graph_right.luau",
        "static_graph_state.luau",
        "static_import_counter.luau",
        "static_import_main.luau",
        "static_initializer_failure.luau",
        "static_initializer_main.luau",
        "static_initializer_probe.luau",
        "structural_core.luau",
        "silent_return.luau",
        "slow_add.luau",
        "vararg_forward.luau",
    ],
    visibility = ["//memcontainers/programs/luau/aot/runtime:__pkg__"],
)

zig_library(
    name = "backend",
    main = "lower.zig",
    import_name = "luau_aot_backend",
    srcs = ["static_package_v1.zig"],
    visibility = ["//visibility:public"],
    deps = [
        "//memcontainers/programs/luau/aot/compiler/ir:frontend_snapshot_v1",
        "//memcontainers/programs/luau/aot/compiler/wasm:object",
    ],
)

# A zero-import host capability that converts the validated frontend snapshot into a relocatable
# wasm32 object. The C++ Luau pin adapter and the Zig backend remain independently instantiable and
# communicate only through FrontendSnapshotV1 bytes.
zig_binary(
    name = "backend_raw",
    srcs = ["backend_host.zig"],
    linkopts = [
        "-fno-entry",
        "--initial-memory=33554432",
        "--max-memory=268435456",
        "--export=mc_luau_backend_v1_alloc",
        "--export=mc_luau_backend_v1_compile",
        "--export=mc_luau_backend_v1_compile_package",
        "--export=mc_luau_backend_v1_compile_static_package",
        "--export=mc_luau_backend_v1_dealloc",
        "--export=mc_luau_backend_v1_free",
    ],
    main = "backend_host.zig",
    tags = ["manual"],
    deps = [":backend"],
)

zig_configure_binary(
    name = "backend_wasm",
    actual = ":backend_raw",
    mode = "release_small",
    tags = ["manual"],
    target = "//platforms:wasm32_wasi",
    threaded = "single",
    visibility = ["//visibility:public"],
)

build_test(
    name = "backend_build_test",
    targets = [":backend_wasm"],
)

js_binary(
    name = "object_emitter",
    entry_point = "object_emitter.mjs",
)

js_binary(
    name = "static_package_emitter",
    entry_point = "static_package_emitter.mjs",
)

# Both exact modules are independently compiled by the zero-import frontend, framed in canonical
# module-name order, and lowered together into one relocatable object with globally unique symbols.
genrule(
    name = "static_import_package_object",
    srcs = [
        ":backend_wasm",
        "static_import_counter.luau",
        "static_import_main.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["static_import_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :static_package_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $@ aot_static_import aot_static_counter=$(location static_import_counter.luau) aot_static_import=$(location static_import_main.luau)",
    tools = [":static_package_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "static_import_package_object_build_test",
    targets = [":static_import_package_object"],
)

# Five modules form two independent transitive paths to one mutable state module. The entry closure
# repeats both top-level requires and is invoked twice by the product guest around full GC.
genrule(
    name = "static_graph_package_object",
    srcs = [
        ":backend_wasm",
        "static_graph_left.luau",
        "static_graph_main.luau",
        "static_graph_middle.luau",
        "static_graph_right.luau",
        "static_graph_state.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["static_graph_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :static_package_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $@ aot_static_graph_main aot_static_graph_left=$(location static_graph_left.luau) aot_static_graph_main=$(location static_graph_main.luau) aot_static_graph_middle=$(location static_graph_middle.luau) aot_static_graph_right=$(location static_graph_right.luau) aot_static_graph_state=$(location static_graph_state.luau)",
    tools = [":static_package_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "static_graph_package_object_build_test",
    targets = [":static_graph_package_object"],
)

# The closed A -> B -> A graph must compile into one package but fail explicitly at runtime instead
# of recursing through source loading, interpreting bytecode, or manufacturing an export placeholder.
genrule(
    name = "static_cycle_package_object",
    srcs = [
        ":backend_wasm",
        "static_cycle_a.luau",
        "static_cycle_b.luau",
        "static_cycle_main.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["static_cycle_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :static_package_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $@ aot_static_cycle_main aot_static_cycle_a=$(location static_cycle_a.luau) aot_static_cycle_b=$(location static_cycle_b.luau) aot_static_cycle_main=$(location static_cycle_main.luau)",
    tools = [":static_package_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "static_cycle_package_object_build_test",
    targets = [":static_cycle_package_object"],
)

# A successfully cached probe counts attempts made by a separate initializer that always raises via
# real arithmetic fallback. Retrying the returned closure proves failures are not cached as successes.
genrule(
    name = "static_initializer_package_object",
    srcs = [
        ":backend_wasm",
        "static_initializer_failure.luau",
        "static_initializer_main.luau",
        "static_initializer_probe.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["static_initializer_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :static_package_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $@ aot_static_initializer_main aot_static_initializer_failure=$(location static_initializer_failure.luau) aot_static_initializer_main=$(location static_initializer_main.luau) aot_static_initializer_probe=$(location static_initializer_probe.luau)",
    tools = [":static_package_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "static_initializer_package_object_build_test",
    targets = [":static_initializer_package_object"],
)

# This is the first build-graph object produced from source through the actual two-capability
# compiler. Downstream runtime/link tests consume this declared output, never a test-only copy.
genrule(
    name = "numeric_loop_object",
    srcs = [
        ":backend_wasm",
        "numeric_loop.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["numeric_loop.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location numeric_loop.luau) $@ 1",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "numeric_loop_object_build_test",
    targets = [":numeric_loop_object"],
)

# Root chunks are variadic in Luau even when they never consume varargs. This declared artifact
# exercises real zero-parameter PREPVARARGS frame relocation and the silent-root gate.
genrule(
    name = "silent_return_object",
    srcs = [
        ":backend_wasm",
        "silent_return.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["silent_return.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location silent_return.luau) $@ 0",
    tools = [":object_emitter"],
    visibility = ["//memcontainers/programs/luau/aot/runtime/glue:__pkg__"],
)

build_test(
    name = "silent_return_object_build_test",
    targets = [":silent_return_object"],
)

# Two-argument addition contains the upstream numeric fast path and its real fallback stream:
# CHECK_TAG -> SET_SAVEDPC/DO_ARITH/JUMP -> shared compiled return block.
genrule(
    name = "slow_add_object",
    srcs = [
        ":backend_wasm",
        "slow_add.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["slow_add.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location slow_add.luau) $@ 1",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "slow_add_object_build_test",
    targets = [":slow_add_object"],
)

# One two-argument source function drives the scalar WP3 tier through addition, subtraction,
# multiplication, division, floor division, modulo, unary negation, a numeric branch, and all of
# their exact upstream fallback/rejoin blocks. Runtime inputs, not source shape, select the branch.
genrule(
    name = "scalar_breadth_object",
    srcs = [
        ":backend_wasm",
        "scalar_breadth.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["scalar_breadth.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location scalar_breadth.luau) $@ 1",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "scalar_breadth_object_build_test",
    targets = [":scalar_breadth_object"],
)

# A runtime truthiness branch selects two different loop shapes over the same numeric argument:
# a descending while-loop that adds and an ascending numeric for-loop that subtracts. The source
# also retains the exact upstream arithmetic and comparison fallback blocks.
genrule(
    name = "structural_core_object",
    srcs = [
        ":backend_wasm",
        "structural_core.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["structural_core.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location structural_core.luau) $@ 1",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "structural_core_object_build_test",
    targets = [":structural_core_object"],
)

# The first closed-package object contains all three canonical Proto/IR functions under unique
# symbols. It is the production backend boundary for closure publication and compiled calls.
genrule(
    name = "compiled_call_package_object",
    srcs = [
        ":backend_wasm",
        "compiled_call.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["compiled_call_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location compiled_call.luau) $@ package",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "compiled_call_package_object_build_test",
    targets = [":compiled_call_package_object"],
)

# The next package vertical keeps the same three-Proto shape while replacing the inner closed child
# with one immutable value capture, one upvalue read, and a fixed one-argument compiled call.
genrule(
    name = "captured_call_package_object",
    srcs = [
        ":backend_wasm",
        "captured_call.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["captured_call_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location captured_call.luau) $@ package",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "captured_call_package_object_build_test",
    targets = [":captured_call_package_object"],
)

# A three-Proto package whose inner function returns two contiguous TValues and whose caller
# consumes both after CALL 2->2 before rejoining through a second arithmetic slow path.
genrule(
    name = "multi_result_call_package_object",
    srcs = [
        ":backend_wasm",
        "multi_result_call.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["multi_result_call_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location multi_result_call.luau) $@ package",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "multi_result_call_package_object_build_test",
    targets = [":multi_result_call_package_object"],
)

# A closed four-Proto package exercises both ends of widened fixed calls: one compiled child is
# invoked with zero parameters and zero results, while another consumes four parameters and returns
# three contiguous results that the caller combines into one runtime-input-dependent number.
genrule(
    name = "general_call_package_object",
    srcs = [
        ":backend_wasm",
        "general_call.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["general_call_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location general_call.luau) $@ package",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "general_call_package_object_build_test",
    targets = [":general_call_package_object"],
)

# The returned variadic caller consumes one fixed value from its runtime varargs, then forwards the
# open list through a variadic child with one fixed parameter. That child's open result list becomes
# the argument list of a fixed four-parameter compiled child before the saved first value is added.
genrule(
    name = "vararg_forward_package_object",
    srcs = [
        ":backend_wasm",
        "vararg_forward.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["vararg_forward_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location vararg_forward.luau) $@ package",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "vararg_forward_package_object_build_test",
    targets = [":vararg_forward_package_object"],
)

# A factory returns a closure over one mutable local. The package preserves an open UpVal through
# LCT_REF, closes it before the factory frame returns, then reads and writes the closed cell.
genrule(
    name = "reference_capture_package_object",
    srcs = [
        ":backend_wasm",
        "reference_capture.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["reference_capture_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location reference_capture.luau) $@ package",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "reference_capture_package_object_build_test",
    targets = [":reference_capture_package_object"],
)

js_test(
    name = "frontend_to_wasm_test",
    data = [
        ":backend_wasm",
        ":frontend_to_wasm.test.mjs",
        "captured_call.luau",
        "compiled_call.luau",
        "multi_result_call.luau",
        "reference_capture.luau",
        "silent_return.luau",
        "slow_add.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
        "@@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld",
    ],
    entry_point = "frontend_to_wasm.test.mjs",
    env = {
        "LUAU_AOT_BACKEND_WASM": "$(rlocationpath :backend_wasm)",
        "LUAU_AOT_CAPTURED_CALL_SOURCE": "$(rlocationpath captured_call.luau)",
        "LUAU_AOT_FRONTEND_WASM": "$(rlocationpath //memcontainers/programs/luau/aot/frontend:frontend_wasm)",
        "LUAU_AOT_COMPILED_CALL_SOURCE": "$(rlocationpath compiled_call.luau)",
        "LUAU_AOT_MULTI_RESULT_CALL_SOURCE": "$(rlocationpath multi_result_call.luau)",
        "LUAU_AOT_REFERENCE_CAPTURE_SOURCE": "$(rlocationpath reference_capture.luau)",
        "LUAU_AOT_SILENT_SOURCE": "$(rlocationpath silent_return.luau)",
        "LUAU_AOT_SLOW_ADD_SOURCE": "$(rlocationpath slow_add.luau)",
        "LUAU_AOT_WASM_LD": "$(rlocationpath @@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld)",
    },
    no_copy_to_bin = ["@@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld"],
)
