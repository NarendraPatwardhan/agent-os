load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure_binary", "zig_library")

exports_files(
    [
        "numeric_loop.luau",
        "compiled_call.luau",
        "silent_return.luau",
        "slow_add.luau",
    ],
    visibility = ["//memcontainers/programs/luau/aot/runtime:__pkg__"],
)

zig_library(
    name = "backend",
    main = "lower.zig",
    import_name = "luau_aot_backend",
    visibility = ["//visibility:public"],
    deps = [
        "//memcontainers/programs/luau/aot/compiler/ir:frontend_snapshot_v1",
        "//memcontainers/programs/luau/aot/compiler/wasm:object",
    ],
)

# A zero-import host capability that converts the validated frontend snapshot into a relocatable
# wasm32 object. The C++ Luau pin adapter and the Zig backend remain independently instantiable and
# communicate only through FrontendSnapshotV1 bytes.
zig_binary(
    name = "backend_raw",
    srcs = ["backend_host.zig"],
    linkopts = [
        "-fno-entry",
        "--initial-memory=33554432",
        "--max-memory=268435456",
        "--export=mc_luau_backend_v1_alloc",
        "--export=mc_luau_backend_v1_compile",
        "--export=mc_luau_backend_v1_compile_package",
        "--export=mc_luau_backend_v1_dealloc",
        "--export=mc_luau_backend_v1_free",
    ],
    main = "backend_host.zig",
    tags = ["manual"],
    deps = [":backend"],
)

zig_configure_binary(
    name = "backend_wasm",
    actual = ":backend_raw",
    mode = "release_small",
    tags = ["manual"],
    target = "//platforms:wasm32_wasi",
    threaded = "single",
    visibility = ["//visibility:public"],
)

build_test(
    name = "backend_build_test",
    targets = [":backend_wasm"],
)

js_binary(
    name = "object_emitter",
    entry_point = "object_emitter.mjs",
)

# This is the first build-graph object produced from source through the actual two-capability
# compiler. Downstream runtime/link tests consume this declared output, never a test-only copy.
genrule(
    name = "numeric_loop_object",
    srcs = [
        ":backend_wasm",
        "numeric_loop.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["numeric_loop.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location numeric_loop.luau) $@ 1",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "numeric_loop_object_build_test",
    targets = [":numeric_loop_object"],
)

# Root chunks are variadic in Luau even when they never consume varargs. This declared artifact
# exercises the backend's narrow zero-parameter PREPVARARGS normalization and the silent-root gate.
genrule(
    name = "silent_return_object",
    srcs = [
        ":backend_wasm",
        "silent_return.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["silent_return.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location silent_return.luau) $@ 0",
    tools = [":object_emitter"],
    visibility = ["//memcontainers/programs/luau/aot/runtime/glue:__pkg__"],
)

build_test(
    name = "silent_return_object_build_test",
    targets = [":silent_return_object"],
)

# Two-argument addition contains the upstream numeric fast path and its real fallback stream:
# CHECK_TAG -> SET_SAVEDPC/DO_ARITH/JUMP -> shared compiled return block.
genrule(
    name = "slow_add_object",
    srcs = [
        ":backend_wasm",
        "slow_add.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["slow_add.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location slow_add.luau) $@ 1",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "slow_add_object_build_test",
    targets = [":slow_add_object"],
)

# The first closed-package object contains all three canonical Proto/IR functions under unique
# symbols. It is the production backend boundary for closure publication and compiled calls.
genrule(
    name = "compiled_call_package_object",
    srcs = [
        ":backend_wasm",
        "compiled_call.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
    ],
    outs = ["compiled_call_package.o"],
    cmd = "BAZEL_BINDIR=. $(execpath :object_emitter) $(location //memcontainers/programs/luau/aot/frontend:frontend_wasm) $(location :backend_wasm) $(location compiled_call.luau) $@ package",
    tools = [":object_emitter"],
    visibility = ["//visibility:public"],
)

build_test(
    name = "compiled_call_package_object_build_test",
    targets = [":compiled_call_package_object"],
)

js_test(
    name = "frontend_to_wasm_test",
    data = [
        ":backend_wasm",
        ":frontend_to_wasm.test.mjs",
        "compiled_call.luau",
        "silent_return.luau",
        "slow_add.luau",
        "//memcontainers/programs/luau/aot/frontend:frontend_wasm",
        "@@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld",
    ],
    entry_point = "frontend_to_wasm.test.mjs",
    env = {
        "LUAU_AOT_BACKEND_WASM": "$(rlocationpath :backend_wasm)",
        "LUAU_AOT_FRONTEND_WASM": "$(rlocationpath //memcontainers/programs/luau/aot/frontend:frontend_wasm)",
        "LUAU_AOT_COMPILED_CALL_SOURCE": "$(rlocationpath compiled_call.luau)",
        "LUAU_AOT_SILENT_SOURCE": "$(rlocationpath silent_return.luau)",
        "LUAU_AOT_SLOW_ADD_SOURCE": "$(rlocationpath slow_add.luau)",
        "LUAU_AOT_WASM_LD": "$(rlocationpath @@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld)",
    },
    no_copy_to_bin = ["@@emsdk++emscripten_deps+emscripten_bin_linux//:bin/wasm-ld"],
)
