LAYOUT_FIELD(OFF_TSTRING_HASH, offsetof(TString, hash))
LAYOUT_FIELD(OFF_TSTRING_LEN, offsetof(TString, len))
LAYOUT_FIELD(OFF_TSTRING_DATA, offsetof(TString, data))

LAYOUT_FIELD(SIZE_UDATA, sizeof(Udata))
