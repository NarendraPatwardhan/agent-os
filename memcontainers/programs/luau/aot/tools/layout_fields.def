LAYOUT_FIELD(OFF_UDATA_LEN, offsetof(Udata, len))
LAYOUT_FIELD(OFF_UDATA_METATABLE, offsetof(Udata, metatable))
LAYOUT_FIELD(OFF_UDATA_DATA, offsetof(Udata, data))

LAYOUT_FIELD(SIZE_BUFFER, sizeof(Buffer))
