// Ordered wasm32 Luau layout contract.
//
// This file is included by layout_probe.cpp with LAYOUT_FIELD(name, expression)
// defined. Keep expressions target-compiled: the checked manifest must describe the
// actual wasm32 ABI, never the host that happens to run the build.

LAYOUT_FIELD(ABI_POINTER_SIZE, sizeof(void*))
LAYOUT_FIELD(ABI_SIZE_T_SIZE, sizeof(size_t))
LAYOUT_FIELD(ABI_INSTRUCTION_SIZE, sizeof(Instruction))
LAYOUT_FIELD(ABI_LUA_EXTRA_SIZE, LUA_EXTRA_SIZE)
LAYOUT_FIELD(ABI_LUA_VECTOR_SIZE, LUA_VECTOR_SIZE)

LAYOUT_FIELD(SIZE_VALUE, sizeof(Value))
LAYOUT_FIELD(ALIGN_VALUE, alignof(Value))
LAYOUT_FIELD(SIZE_TVALUE, sizeof(TValue))
LAYOUT_FIELD(ALIGN_TVALUE, alignof(TValue))
LAYOUT_FIELD(OFF_TVALUE_VALUE, offsetof(TValue, value))
LAYOUT_FIELD(OFF_TVALUE_EXTRA, offsetof(TValue, extra))
LAYOUT_FIELD(OFF_TVALUE_TAG, offsetof(TValue, tt))

LAYOUT_FIELD(SIZE_GC_HEADER, sizeof(GCheader))
LAYOUT_FIELD(ALIGN_GC_HEADER, alignof(GCheader))
LAYOUT_FIELD(OFF_GC_HEADER_TAG, offsetof(GCheader, tt))
LAYOUT_FIELD(OFF_GC_HEADER_MARKED, offsetof(GCheader, marked))
LAYOUT_FIELD(OFF_GC_HEADER_MEMCAT, offsetof(GCheader, memcat))

