# rules_js requires non-JavaScript data outside this package to enter through the output tree. This
# preserves the source byte-for-byte while making the differential oracle consume the very same file
# as the frontend/backend object build.
genrule(
    name = "ir_runtime_oracle_source",
    srcs = ["//memcontainers/programs/luau/aot/compiler/backend:numeric_loop.luau"],
    outs = ["ir_runtime_oracle_source.luau"],
    cmd = "cp $(location //memcontainers/programs/luau/aot/compiler/backend:numeric_loop.luau) $@",
)

js_test(
    name = "ir_runtime_oracle_test",
    data = [
        ":interpreter_oracle_wasm",
        ":ir_runtime_oracle_source",
        ":ir_runtime_oracle_wasm",
        "oracle/oracle.test.mjs",
    ],
    entry_point = "oracle/oracle.test.mjs",
    env = {
        "LUAU_INTERPRETER_ORACLE_WASM": "$(rlocationpath :interpreter_oracle_wasm)",
        "LUAU_AOT_RUNTIME_ORACLE_WASM": "$(rlocationpath :ir_runtime_oracle_wasm)",
        "LUAU_AOT_RUNTIME_ORACLE_SOURCE": "$(rlocationpath :ir_runtime_oracle_source)",
