# Executable oracle for the first generated-function ABI. Unlike the structural wasm-ld oracle,
# this constructs a real Luau state/Proto/Closure and reaches generated code through ldo's strict
# AOT dispatch hook. It remains an oracle-only target; production entry/package materialization is
# a later layer.
zig_binary(
    name = "ir_runtime_oracle_raw",
    srcs = ["oracle/oracle_root.zig"],
    linkopts = [
        "-lc",
        "-lc++",
        "-fno-entry",
        "--export-memory",
        "--export=__mc_pcall_run",
        "--export=__stack_pointer",
        "--export=mc_luau_aot_v1_oracle_init",
        "--export=mc_luau_aot_v1_oracle_gc_publication",
        "--export=mc_luau_aot_v1_oracle_probe",
        "--export=mc_luau_aot_v1_oracle_reject_non_number",
        "--export=mc_luau_aot_v1_oracle_run_i32",
    ],
    main = "oracle/oracle_root.zig",
    tags = ["manual"],
    deps = [
        ":aot_runtime_abi",
        ":luau_aot_runtime_raw",
        ":ir_function_object_link",
        "//memcontainers/programs/luau/glue:trap",
    ],
)

zig_configure_binary(
    name = "ir_runtime_oracle_wasm",
    actual = ":ir_runtime_oracle_raw",
    mode = "release_small",
    tags = ["manual"],
    target = "//platforms:wasm32_wasi",
    threaded = "single",
)

