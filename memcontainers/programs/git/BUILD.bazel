load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//bazel:mc_program.bzl", "mc_rust_program")
load("//bazel/tools/size:defs.bzl", "size_limit")

# programs/git — thin pure-mc /bin/git over the single host-call boundary.
# Imports ONLY `mc` (no WASI). Size soft gate ≤256 KiB.

rust_binary(
    name = "git_bin",
    srcs = [
        "src/argv.rs",
        "src/main.rs",
    ],
    crate_root = "src/main.rs",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//memcontainers/sysroot/rust:lib",
    ],
)

rust_test(
    name = "argv_test",
    srcs = [
        "src/argv.rs",
        "test/argv_test.rs",
    ],
    crate_root = "test/argv_test.rs",
    edition = "2021",
)

# The host call selects the attached repository; only remote effects use network authority.
mc_rust_program(
    name = "git",
    lib = ":git_bin",
    tier = "full",
    visibility = ["//visibility:public"],
)

# Soft gate on the stamped guest artifact (mc_rust_program default output).
size_limit(
    name = "git_size_limit",
    file = ":git",
    max_bytes = 256 * 1024,
)

# Image layer: /bin/git for host-mediated local and remote verbs.
# Wired into base (and every flavor that stacks on it) via images/BUILD.bazel deps —
# same substrate model as /bin/pkgfsd.
pkg_tar(
    name = "git_layer",
    create_parents = False,
    files = {
        ":git": "/bin/git",
    },
    owner = "0.0",
    visibility = ["//visibility:public"],
)
