load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:mc_program.bzl", "mc_rust_program")
load("//bazel/tools/size:defs.bzl", "size_limit")

# programs/git — thin pure-mc /bin/git (GIT.md PR6). Local porcelain via ctl only.
# Imports ONLY `mc` (no WASI). Size soft gate ≤256 KiB.

rust_binary(
    name = "git_bin",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "//memcontainers/sysroot/rust:lib",
    ],
)

# full tier: local porcelain is fs-only, but remotes use mc_sys_host_call ("git") which needs CAP_NET (A9).
mc_rust_program(
    name = "git",
    lib = ":git_bin",
    tier = "full",
    visibility = ["//visibility:public"],
)

# Soft gate on the stamped guest artifact (mc_rust_program default output).
size_limit(
    name = "git_size_limit",
    file = ":git",
    max_bytes = 256 * 1024,
)

# Image layer: /bin/git for local ctl porcelain + CAP_NET remotes (GIT.md PR6).
# Wired into base (and every flavor that stacks on it) via images/BUILD.bazel deps —
# same substrate model as /bin/pkgfsd.
pkg_tar(
    name = "git_layer",
    create_parents = False,
    files = {
        ":git": "/bin/git",
    },
    owner = "0.0",
    visibility = ["//visibility:public"],
)
